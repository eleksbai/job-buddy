app:
  name: Job Buddy
  env: local
  host: 0.0.0.0
  port: 8000

log:
  level: INFO
  dir: logs
  file: job-buddy.log
  max_bytes: 10485760
  backup_count: 5

mongo:
  uri: mongodb://localhost:27017
  db: job_buddy

boss:
  default_greeting: 您好，我对该岗位很感兴趣，希望能和您聊一聊。
  profile_dir: data/chrome_profile
  proxy: ""

ai:
  providers:
    - name: openai
      url: https://api.openai.com/v1
      model: gpt-3.5-turbo
      api_key: ""
  default_provider: openai
  resume_path: data/resume.md
  criteria_path: data/matching_criteria.md
  conversation_style_path: data/conversation_style.md
  request_delay_seconds: 1.0
  temperature: 0.1
