app:
  name: Job Buddy
  env: local
  host: 0.0.0.0
  port: 8000

log:
  level: INFO
  dir: logs
  file: job-buddy.log
  max_bytes: 10485760
  backup_count: 5

mongo:
  uri: mongodb://localhost:27017
  db: job_buddy

boss:
  profile_dir: data/chrome_profile
  proxy: ""

feishu:
  enabled: true

ai:
  providers:
    - name: openai
      url: https://api.openai.com/v1
      model: gpt-3.5-turbo
      api_key: ""
  default_provider: openai
  request_delay_seconds: 1.0
  temperature: 0.1
